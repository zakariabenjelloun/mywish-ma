# ──────────────────────────────────────────────────
# MyWish.ma — Environment Variables Template
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it's gitignored.
# Each environment (local / dev / prod) has its OWN .env file.
# ──────────────────────────────────────────────────

# ─────────────────────────────────────────────
# 🌍 Environment
# ─────────────────────────────────────────────
# Values: local, dev, prod
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NAME=MyWish.ma
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr

# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ─────────────────────────────────────────────
# 🗄️ Database (MySQL)
# ─────────────────────────────────────────────
# LOCAL example:
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_NAME=mywish_local
#   DB_USER=root
#   DB_PASS=
#
# DEV (cPanel) example:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_NAME=cpaneluser_mywish_dev
#   DB_USER=cpaneluser_mywish_dev
#   DB_PASS=YourStrongPassword123!
#
# PROD (cPanel) example:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_NAME=cpaneluser_mywish_prod
#   DB_USER=cpaneluser_mywish_prod
#   DB_PASS=AnotherStrongPassword456!
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mywish_local
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─────────────────────────────────────────────
# 🔐 Google OAuth
# ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ─────────────────────────────────────────────
# 📱 WhatsApp Cloud API (Meta)
# ─────────────────────────────────────────────
# https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─────────────────────────────────────────────
# 📧 Email (SMTP via Resend, Brevo, or any provider)
# ─────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@mywish.ma
MAIL_FROM_NAME="MyWish.ma"

# ─────────────────────────────────────────────
# 📸 Cloudinary (image storage)
# ─────────────────────────────────────────────
# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ─────────────────────────────────────────────
# 💳 Stripe (Premium payments)
# ─────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# 💳 CMI (Maroc payments) - V1+
# ─────────────────────────────────────────────
# CMI_MERCHANT_ID=
# CMI_API_KEY=
# CMI_STORE_KEY=

# ─────────────────────────────────────────────
# 💳 PayPal (diaspora) - V1+
# ─────────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# ─────────────────────────────────────────────
# 🔧 Session & Cookies
# ─────────────────────────────────────────────
SESSION_NAME=mywish_session
SESSION_LIFETIME=2592000
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# ─────────────────────────────────────────────
# 📊 Analytics (optional, V1+)
# ─────────────────────────────────────────────
# PLAUSIBLE_DOMAIN=mywish.ma
