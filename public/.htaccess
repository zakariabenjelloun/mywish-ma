# ═══════════════════════════════════════════════════════════════════
# MyWish.ma — .htaccess for the public/ directory (web root)
# ═══════════════════════════════════════════════════════════════════
#
# This file:
# 1. Routes all requests through index.php (front controller)
# 2. Adds security headers
# 3. Blocks access to sensitive files
# 4. Enables compression
#
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────
# Block access to dotfiles (.env, .git, etc.)
# ─────────────────────────────────────────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to .env explicitly (just in case)
<Files ".env">
    Require all denied
</Files>

# ─────────────────────────────────────────────────
# Block access to common config files
# ─────────────────────────────────────────────────
<FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|\.cpanel\.yml|README\.md|CLAUDE\.md|\.gitignore)$">
    Require all denied
</FilesMatch>

# ─────────────────────────────────────────────────
# Block access to PHP files outside index.php
# (extra layer — they shouldn't be in public/ anyway)
# ─────────────────────────────────────────────────
<FilesMatch "\.(sql|md|log|bak|backup|swp|inc)$">
    Require all denied
</FilesMatch>

# ─────────────────────────────────────────────────
# Block access to sensitive directories
# (in case src/, database/, storage/ end up next to public/)
# ─────────────────────────────────────────────────
RedirectMatch 404 ^/src/
RedirectMatch 404 ^/database/
RedirectMatch 404 ^/storage/
RedirectMatch 404 ^/vendor/
RedirectMatch 404 ^/scripts/
RedirectMatch 404 ^/docs/
RedirectMatch 404 ^/\.git/

# ─────────────────────────────────────────────────
# Front controller pattern: route everything through index.php
# ─────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to HTTPS (uncomment in production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect www to non-www (uncomment if needed)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # If the request is for a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, route everything to index.php
    RewriteRule ^ index.php [L]
</IfModule>

# ─────────────────────────────────────────────────
# Security Headers
# ─────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS protection (legacy but still useful)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy (was Feature-Policy)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HSTS (uncomment in production once HTTPS is set up)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─────────────────────────────────────────────────
# Disable directory listing
# ─────────────────────────────────────────────────
Options -Indexes

# ─────────────────────────────────────────────────
# Compression (Gzip)
# ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ─────────────────────────────────────────────────
# Browser caching for static assets
# ─────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS / JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # HTML (should always be fresh)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─────────────────────────────────────────────────
# Force PHP version (cPanel-specific — adjust if needed)
# ─────────────────────────────────────────────────
# AddHandler application/x-httpd-ea-php82 .php

# ─────────────────────────────────────────────────
# Custom error pages (later)
# ─────────────────────────────────────────────────
# ErrorDocument 404 /errors/404.php
# ErrorDocument 500 /errors/500.php
